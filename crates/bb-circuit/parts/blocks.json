      {"element": "C", "kind": "voltage", "limit": "$(voltage)", "tau": 0.05, "destroy_at": 1.4, "message": "electrolytic over-voltage — pop!", "effect": "pop"}
    ],
    "bench": {"art": "cap_electrolytic", "layout": {"axial": 1}},
    "schematic": {"symbol": "capacitor_polarized"},
    "pcb": {"footprint": "Capacitor_THT:CP_Radial_D6.3mm_P2.50mm"},
    "tags": ["spice"]
  },
