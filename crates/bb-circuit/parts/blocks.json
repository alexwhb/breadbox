  {
    "id": "resistor", "name": "Resistor", "category": "building_blocks",
    "simple": true, "icon": "res", "ref_prefix": "R",
    "description": "Limits current. Pick an E-series value and watch the colour bands change.",
    "props": [
      {"key": "resistance", "label": "Resistance", "unit": "Ω", "type": "number", "default": 10000, "min": 0.01, "max": 1e9, "series": "E24", "live": true},
      {"key": "tolerance", "label": "Tolerance", "unit": "%", "type": "choice", "default": "5", "options": [{"value": "1"}, {"value": "2"}, {"value": "5"}, {"value": "10"}]},
      {"key": "power", "label": "Power rating", "unit": "W", "type": "number", "default": 0.25, "min": 0.0625, "max": 10},
      {"key": "tempco", "label": "Tempco", "unit": "ppm/°C", "type": "number", "default": 100, "min": 0, "max": 5000}
    ],
    "pins": ["1", "2"],
    "model": {
      "spice": ["$(el:R) $(1) $(2) {$(ext:r)*(1+$(tempco)*1e-6*($(ext:temp)-25))}"],
      "pro": ["$(el:R) $(1) $(2) $(resistance)"],
      "ext": [{"name": "temp", "default": 25}, {"name": "r", "default": "$(resistance)"}],
      "behaviour": "thermal",
      "device_pins": []
    },
    "inspector": [
      {"label": "Resistance", "value": "$(resistance|Ω) ±$(tolerance) %"},
      {"label": "Power rating", "value": "$(power|W)"},
      {"label": "Tempco", "value": "$(tempco) ppm/°C"},
      {"label": "Model", "value": "R · self-heating → R(T)"}
    ],
    "ratings": [{"element": "R", "kind": "power", "limit": "$(power)", "tau": 3.0, "destroy_at": 3.0, "message": "resistor overheated", "effect": "smoke"}],
    "bench": {"art": "resistor_axial", "layout": {"axial": 4}, "flexible": true},
    "schematic": {"symbol": "resistor"},
    "pcb": {"footprint": "Resistor_THT:R_Axial_DIN0207_L6.3mm_D2.5mm_P10.16mm_Horizontal", "smd": "Resistor_SMD:R_0805_2012Metric"},
    "tags": ["spice"]
  },
