      {"key": "esr", "label": "ESR", "unit": "Ω", "type": "number", "default": 0.2, "min": 0.001, "max": 100}
    ],
    "pins": ["plus::+", "minus::−"],
    "model": {"spice": ["$(el:C) $(plus) $(n:esr) $(capacitance)", "$(el:R:esr) $(n:esr) $(minus) $(esr)"]},
    "inspector": [
