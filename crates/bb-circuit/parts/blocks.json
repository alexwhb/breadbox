  {
    "id": "potentiometer", "name": "Potentiometer", "category": "building_blocks",
    "simple": true, "simple_name": "Knob (pot)", "icon": "pot", "ref_prefix": "RV",
    "description": "Turn the knob: a variable voltage divider between the outer pins.",
    "props": [
      {"key": "resistance", "label": "Resistance", "unit": "Ω", "type": "number", "default": 10000, "min": 100, "max": 1e7, "series": "E6"},
      {"key": "position", "label": "Knob", "type": "number", "default": 0.5, "min": 0, "max": 1, "live": true}
    ],
    "pins": ["1", "w::wiper", "3"],
    "model": {
      "spice": [
        "$(el:R:a) $(1) $(w) {max($(resistance)*$(ext:pos),0.1)}",
        "$(el:R:b) $(w) $(3) {max($(resistance)*(1-$(ext:pos)),0.1)}"
      ],
      "pro": ["$(el:R:a) $(1) $(w) {max($(resistance)*$(position),0.1)}", "$(el:R:b) $(w) $(3) {max($(resistance)*(1-$(position)),0.1)}"],
