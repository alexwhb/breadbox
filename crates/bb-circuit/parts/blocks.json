  {
    "id": "capacitor_electrolytic", "name": "Capacitor (electrolytic)", "category": "building_blocks",
    "icon": "cap", "ref_prefix": "C",
    "description": "Big capacitance, polarised: the stripe is −. Reverse it and it pops.",
    "props": [
      {"key": "capacitance", "label": "Capacitance", "unit": "F", "type": "number", "default": 1e-4, "min": 1e-7, "max": 1, "series": "E6"},
