[
  {
    "id": "ldr", "name": "Light sensor (LDR)", "part_number": "GL5528", "category": "sensors",
    "simple": true, "simple_name": "Light", "icon": "ldr", "ref_prefix": "LDR",
    "description": "Photoresistor: R ≈ 350k·lux^-0.7. Pair it with a 10 k resistor as a divider.",
    "props": [
      {"key": "r1lux", "label": "R at 1 lx", "unit": "Ω", "type": "number", "default": 350000, "min": 1000, "max": 1e8},
      {"key": "gamma", "label": "γ", "type": "number", "default": 0.7, "min": 0.3, "max": 1.2},
      {"key": "tolerance", "label": "Tolerance", "unit": "%", "type": "number", "default": 10}
    ],
    "pins": ["1", "2"],
    "model": {
      "spice": ["$(el:R) $(1) $(2) {$(r1lux)*pwr(max($(ext:lux),0.01),-$(gamma))}"],
      "pro": ["$(el:R) $(1) $(2) {$(r1lux)*pwr(max($(world:lux),0.01),-$(gamma))} tol=0.1"],
      "ext": [{"name": "lux", "default": 180}],
      "behaviour": "ldr",
      "device_pins": []
    },
    "inspector": [
      {"label": "Resistance", "value": "≈ 350k·lux^-0.7 ±$(tolerance) %"},
      {"label": "Dark", "value": "≥ 1 MΩ"},
      {"label": "Response", "value": "rise 20 ms · decay 30 ms"},
      {"label": "Model", "value": "world.lux → R(lux)"}
    ],
    "bench": {"art": "ldr", "layout": {"axial": 2}, "flexible": true},
    "schematic": {"symbol": "photoresistor"},
    "pcb": {"footprint": "OptoDevice:R_LDR_5.1x4.3mm_P3.4mm_Vertical"},
    "tags": ["spice", "world"]
  },
  {
    "id": "capsoil", "name": "Capacitive soil sensor v1.2", "category": "sensors",
    "simple": true, "simple_name": "Soil moisture", "icon": "soil", "ref_prefix": "J",
    "description": "Push it into a pot: analog output falls from ~3.0 V (dry) to ~1.4 V (wet).",
    "props": [
      {"key": "v_dry", "label": "Output at 0 % VWC", "unit": "V", "type": "number", "default": 3.03},
      {"key": "slope", "label": "Slope", "unit": "V/%", "type": "number", "default": -0.02737},
      {"key": "tau", "label": "Response τ", "unit": "s", "type": "number", "default": 1.8, "min": 0.01, "max": 60, "live": true},
      {"key": "noise_lsb", "label": "Noise", "unit": "LSB", "type": "number", "default": 4, "min": 0, "max": 50, "live": true}
    ],
    "pins": ["GND:ground", "VCC:power_in", "AOUT:analog_out"],
    "model": {
      "behaviour": "capsoil",
      "pro": ["$(el:X) $(VCC) $(GND) $(AOUT) CAPSOIL vwc=$(world:vwc)"],
      "library": [
        ".subckt CAPSOIL vcc vss out params: vwc=40\nB1 int vss V={3.03-0.02737*vwc}\nR1 int out 2.2k\nR2 vcc vss 1k\n.ends CAPSOIL"
      ]
    },
    "inspector": [
      {"label": "Supply", "value": "3.3–5.5 V"},
      {"label": "Output (dry→wet)", "value": "3.0→1.4 V"},
      {"label": "Response", "value": "τ ≈ $(tau) s"},
      {"label": "Noise", "value": "±$(noise_lsb) LSB"},
      {"label": "Model", "value": "soil.vwc → C(ε)"}
    ],
    "bench": {"art": "capsoil_v12", "layout": "row", "size": [3, 10]},
    "schematic": {"symbol": "box"},
    "pcb": {"footprint": "Connector_JST:JST_PH_B3B-PH-K_1x03_P2.00mm_Vertical"},
    "tags": ["world"]
  },
