[
  {
    "id": "uno", "name": "Arduino UNO R3", "part_number": "ATmega328P", "category": "boards",
    "simple": true, "simple_name": "UNO R3", "icon": "uno", "ref_prefix": "U",
    "description": "The classic. ATmega328P at 16 MHz running your real compiled sketch, cycle-accurate.",
    "pins": [],
    "model": {
      "mcu": {"board": "uno", "core": "avr", "vcc_pin": "5V", "label": "ATmega328P @ 16 MHz"},
      "behaviour": "board_power",
      "device_pins": [],
      "ext": [{"name": "fuse_r", "default": 0.1}],
      "spice": [
        "$(el:V:usb) $(n:usb) $(GND) 5.0",
        "$(el:R:cable) $(n:usb) $(n:fuse) 0.3",
        "$(el:R:fuse) $(n:fuse) $(5V) {$(ext:fuse_r)}",
        "$(el:R:load) $(5V) $(GND) 130",
        "$(el:B:reg) $(n:r3) $(GND) V=min(3.3,max(v($(5V),$(GND))-0.25,0))",
        "$(el:R:reg) $(n:r3) $(n:r3s) 0.5",
        "$(el:V:regs) $(n:r3s) $(3V3) 0",
        "$(el:F:reg) $(5V) $(GND) $(el:V:regs) 1",
        "$(el:R:ioref) $(5V) $(IOREF) 0.01",
        "$(el:R:rst) $(5V) $(RESET) 10k",
        "$(el:R:vin) $(VIN) $(GND) 1Meg",
        "$(el:R:aref) $(AREF) $(GND) 1G"
      ],
      "pro": [
        "$(el:V:usb) $(n:usb) $(GND) 5.0",
        "$(el:R:cable) $(n:usb) $(5V) 0.4",
        "$(el:R:load) $(5V) $(GND) 130"
      ]
    },
    "ratings": [{"element": "R:fuse", "kind": "current", "limit": 0.5, "tau": 1.0, "destroy_at": 1000, "message": "USB current over 500 mA", "effect": "none"}],
    "inspector": [
      {"label": "MCU", "value": "ATmega328P · 16 MHz · cycle-accurate AVR core"},
      {"label": "Flash / SRAM", "value": "32 KB / 2 KB"},
      {"label": "Supply", "value": "USB 5 V · 500 mA polyfuse"},
      {"label": "Pin current", "value": "40 mA abs. max per pin"}
    ],
    "bench": {"art": "uno_r3", "layout": {"board": "uno"}, "sockets": true},
    "schematic": {"symbol": "box"},
    "pcb": {"footprint": "Breadbox:Arduino_UNO_R3_Shield"},
    "tags": ["firmware", "spice", "3d"]
