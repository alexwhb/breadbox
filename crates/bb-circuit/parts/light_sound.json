        "?common=cathode:$(el:D:b) $(B) $(COM) LED_RGB_B",
        "?common=anode:$(el:D:r) $(COM) $(R) LED_RGB_R",
        "?common=anode:$(el:D:g) $(COM) $(G) LED_RGB_G",
        "?common=anode:$(el:D:b) $(COM) $(B) LED_RGB_B"
      ],
      "library": [
        ".model LED_RGB_R D(Is=1e-18 N=1.9 Rs=8)",
        ".model LED_RGB_G D(Is=1e-26 N=2.0 Rs=12)",
        ".model LED_RGB_B D(Is=1e-26 N=2.0 Rs=12)"
      ],
      "behaviour": "rgb_led",
      "device_pins": []
    },
    "ratings": [
      {"element": "D:r", "kind": "current", "limit": 0.03, "tau": 0.02, "destroy_at": 3.0, "message": "red die burnt out", "effect": "open"},
      {"element": "D:g", "kind": "current", "limit": 0.03, "tau": 0.02, "destroy_at": 3.0, "message": "green die burnt out", "effect": "open"},
      {"element": "D:b", "kind": "current", "limit": 0.03, "tau": 0.02, "destroy_at": 3.0, "message": "blue die burnt out", "effect": "open"}
    ],
    "bench": {"art": "rgb_led", "layout": "row"},
