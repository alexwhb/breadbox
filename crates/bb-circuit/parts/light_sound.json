    "props": [{"key": "common", "label": "Common pin", "type": "choice", "default": "cathode", "options": [{"value": "cathode", "label": "Common cathode"}, {"value": "anode", "label": "Common anode"}]}],
    "pins": ["R", "COM", "G", "B"],
