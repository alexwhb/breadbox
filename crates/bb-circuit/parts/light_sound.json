[
  {
    "id": "led", "name": "LED", "category": "light_sound",
    "simple": true, "icon": "led", "ref_prefix": "D",
    "description": "5 mm LED. Glows with the current through it — and burns out without a resistor.",
    "props": [
      {"key": "color", "label": "Colour", "type": "choice", "default": "red", "options": [
        {"value": "red", "label": "Red"}, {"value": "amber", "label": "Amber"}, {"value": "yellow", "label": "Yellow"},
        {"value": "green", "label": "Green"}, {"value": "blue", "label": "Blue"}, {"value": "white", "label": "White"}
      ]},
      {"key": "if_rated", "label": "Rated current", "unit": "A", "type": "number", "default": 0.02, "min": 0.001, "max": 0.1}
    ],
    "pins": ["a:passive:A", "k:passive:K"],
    "model": {
      "spice": ["$(el:D) $(a) $(k) LED_$(prop:color)"],
      "library": [
        "?color=red:.model LED_RED D(Is=1e-18 N=1.9 Rs=5)",
        "?color=amber:.model LED_AMBER D(Is=1e-19 N=1.8 Rs=6)",
        "?color=yellow:.model LED_YELLOW D(Is=1e-19 N=1.85 Rs=6)",
        "?color=green:.model LED_GREEN D(Is=1e-20 N=1.9 Rs=5)",
        "?color=blue:.model LED_BLUE D(Is=1e-26 N=2.0 Rs=10)",
        "?color=white:.model LED_WHITE D(Is=1e-26 N=2.0 Rs=10)"
      ],
      "behaviour": "led",
      "device_pins": []
    },
    "inspector": [
      {"label": "Colour", "value": "$(color)"},
      {"label": "Rated current", "value": "$(if_rated|A)"},
      {"label": "Abs. max", "value": "30 mA continuous"},
      {"label": "Model", "value": "D · LED_$(color)"}
    ],
    "ratings": [{"element": "D", "kind": "current", "limit": 0.03, "tau": 0.02, "destroy_at": 3.0, "message": "LED burnt out", "effect": "open"}],
    "bench": {"art": "led_5mm", "layout": {"axial": 1}},
    "schematic": {"symbol": "led"},
    "pcb": {"footprint": "LED_THT:LED_D5.0mm", "smd": "LED_SMD:LED_0805_2012Metric"},
    "tags": ["spice"]
  },
  {
    "id": "rgb_led", "name": "RGB LED", "category": "light_sound",
    "simple": true, "icon": "rgb", "ref_prefix": "D",
